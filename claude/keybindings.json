{
  "$schema": "https://www.schemastore.org/claude-code-keybindings.json",
  "$docs": "https://code.claude.com/docs/en/keybindings",
  "bindings": [
    {
      "context": "Global",
      "bindings": {
        "alt+u": "scroll:halfPageUp",
        "alt+d": "scroll:halfPageDown",
        "alt+b": "scroll:fullPageUp",
        "alt+f": "scroll:fullPageDown",
        "alt+g": "scroll:top",
        "alt+shift+g": "scroll:bottom"
      }
    }
  ]
}
